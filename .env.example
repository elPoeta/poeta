# Copia este archivo a .env SOLO si no usas el gestor de secretos del sistema.
# El plan (secc. 7) prefiere el gestor de secretos; .env esta en .gitignore.
# Nunca subas claves reales al repositorio.

# Variables del entorno de IA existente (ya definidas en tu shell)
# AI_HOME=$HOME/AI
# AI_MODELS=$HOME/AI/models
# AI_VOICES=$HOME/AI/voices
# AI_OUTPUT=$HOME/AI/output
# AI_CACHE=$HOME/AI/cache

# Credenciales cloud (solo se usan con autorizacion explicita, nunca automaticamente)
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
